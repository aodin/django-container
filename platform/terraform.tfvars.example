# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

# The Github owner and repository
github_owner_name = "your-org"
github_owner_id   = 0

github_repository_name = "django-container"
github_repository_id   = 0

# Local AWS profile to run tofu as. Leave empty (or delete) in CI so the
# assumed OIDC role is used instead.
aws_profile = "default"

aws_region  = "us-east-1"
project     = "django-container"
environment = "production"

# HTTPS. See the HTTPS section of the README for the two-phase apply.
# Phase 1 - request and validate the certificate:
# create_certificate = true
# app_domain         = "app.example.com"
# route53_zone_id    = "Z0123456789ABCDEFGHIJ"   # omit if DNS is elsewhere
# subject_alternative_names = ["www.example.com"]
#
# Phase 2 - paste `tofu output -raw acm_certificate_arn` here and apply again.
# Keep create_certificate = true; setting it false destroys this certificate.
# certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/xxxxxxxx"

# Sizing
task_cpu      = 512
task_memory   = 1024
desired_count = 2
min_capacity  = 2
max_capacity  = 6

# Database
db_instance_class      = "db.t4g.micro"
db_multi_az            = false
db_deletion_protection = true
